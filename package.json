{
  "name": "nilfalse.github.io",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "start": "react-router dev",
    "test": "vitest",
    "serve": "python3 -m http.server --directory build/client",
    "fmt": "prettier -w .",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lodash-es": "^4.18.1",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@react-router/fs-routes": "^8",
    "@svgr/plugin-svgo": "^8.1.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.6",
    "typescript": "^7",
    "user-agent-data-types": "^0.4.3",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "<BUILTIN_MODULES>",
      "<THIRD_PARTY_MODULES>",
      "^~(?!.*\\.css(?:\\?.*)?$)(.+)$",
      "^(?:\\.{1,2}/)(?!\\+)(?!.*\\.css(?:\\?.*)?$).*",
      "^\\./\\+.*$",
      "\\.css(?:\\?.*)?$"
    ],
    "importOrderSeparation": true,
    "singleQuote": true
  }
}
